---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Machinery Academy | Plataforma de Entrenamiento para Operadores',
  description = 'Capacitación técnica, inspección pre-operacional 3D y simuladores para operadores de maquinaria pesada.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0e17] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-amber-500 selection:text-slate-950">
    <!-- Top Safety Stripe -->
    <div class="h-1.5 w-full hazard-stripe"></div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-11 h-11 rounded-xl bg-amber-500 flex items-center justify-center font-black text-slate-950 text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xl font-black tracking-tight text-white group-hover:text-amber-400 transition-colors">
                MACHINERY<span class="text-amber-500">ACADEMY</span>
              </span>
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                PRO v1.0
              </span>
            </div>
            <div class="text-[11px] text-slate-400 tracking-wider uppercase font-semibold">
              Centro Técnico de Operadores Pesados
            </div>
          </div>
        </a>

        <!-- Main Nav Links -->
        <nav class="hidden md:flex items-center gap-1 font-medium text-sm">
          <a
            href="/"
            class="px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors"
          >
            Inicio
          </a>
          <a
            href="/maquinas"
            class="px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors"
          >
            Maquinaria Pesada
          </a>
          <a
            href="/seguridad"
            class="px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors"
          >
            Seguridad & LOTO
          </a>
          <a
            href="/simulador"
            class="px-3.5 py-2 rounded-xl text-amber-400 hover:text-amber-300 hover:bg-amber-500/10 border border-amber-500/20 transition-all font-semibold flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Simulador Cabina
          </a>
        </nav>

        <!-- Right Quick Action -->
        <div class="flex items-center gap-3">
          <a
            href="/maquinas/excavadora-hidraulica"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md shadow-amber-500/20 hover:scale-[1.02]"
          >
            Comenzar Entrenamiento
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800/80 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-8 rounded-lg bg-amber-500 flex items-center justify-center font-bold text-slate-950">
                ⚡
              </div>
              <span class="text-lg font-black tracking-tight text-white">
                MACHINERY<span class="text-amber-500">ACADEMY</span>
              </span>
            </div>
            <p class="text-sm text-slate-400 max-w-md leading-relaxed">
              Plataforma interactiva especializada en la formación, inspección pre-operacional con visor 3D y evaluación de procedimientos para operadores de excavadoras, cargadores frontales y retroexcavadoras.
            </p>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">
              Catálogo de Equipos
            </h4>
            <ul class="space-y-2 text-sm text-slate-400">
              <li><a href="/maquinas/excavadora-hidraulica" class="hover:text-white transition-colors">Excavadora Hidráulica CAT 320</a></li>
              <li><a href="/maquinas/cargador-frontal" class="hover:text-white transition-colors">Cargador Frontal CAT 950</a></li>
              <li><a href="/maquinas/retroexcavadora" class="hover:text-white transition-colors">Retroexcavadora CAT 420</a></li>
              <li><a href="/simulador" class="hover:text-white transition-colors">Simulador de Mandos</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">
              Estándar de Seguridad
            </h4>
            <ul class="space-y-2 text-sm text-slate-400">
              <li><a href="/seguridad" class="hover:text-white transition-colors">Protocolo LOTO</a></li>
              <li><a href="/seguridad" class="hover:text-white transition-colors">EPP Ocupacional</a></li>
              <li><a href="/seguridad" class="hover:text-white transition-colors">Zonas de Riesgo y Radios</a></li>
              <li><a href="/maquinas" class="hover:text-white transition-colors">Checklist de Mantenimiento</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© 2026 Machinery Academy. Diseñado bajo estándares de seguridad minera y de construcción.</p>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Sistema Operativo al 100%</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
