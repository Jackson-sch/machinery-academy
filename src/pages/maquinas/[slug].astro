---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Visor3D from '../../components/Visor3D';
import ChecklistMantenimiento from '../../components/ChecklistMantenimiento';
import Quiz from '../../components/Quiz';

export async function getStaticPaths() {
  const maquinas = await getCollection('maquinas');
  return maquinas.map((maquina) => ({
    params: { slug: maquina.id },
    props: { maquina },
  }));
}

const { maquina } = Astro.props;
const { Content } = await render(maquina);

// Determine machine 3D type
const machine3dType = maquina.id.includes('cargador')
  ? 'cargador'
  : maquina.id.includes('retro')
  ? 'retroexcavadora'
  : 'excavadora';
---

<BaseLayout
  title={`${maquina.data.title} | Inspección 3D y Capacitación - Machinery Academy`}
  description={maquina.data.description}
>
  <!-- Top Breadcrumb & Machine Hero -->
  <div class="bg-industrial-grid border-b border-slate-800 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <a href="/maquinas" class="hover:text-white transition-colors">Maquinas</a>
        <span>/</span>
        <span class="text-amber-400 font-bold">{maquina.data.title}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="px-3 py-1 rounded text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30">
              {maquina.data.category}
            </span>
            <span class="text-xs font-mono text-slate-400">
              Nivel: {maquina.data.difficulty} • Duración: {maquina.data.durationHours}h
            </span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            {maquina.data.title}
          </h1>
          <p class="text-base text-slate-400 mt-2 max-w-3xl">
            {maquina.data.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="/simulador"
            class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2"
          >
            🕹️ Simulador de Operación
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- SECTION 1: 3D Technical Inspection -->
    <section id="visor-3d">
      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-amber-500">
            Fase de Inspección Visual 360°
          </div>
          <h2 class="text-2xl font-black text-white">
            Puntos Críticos de Inspección 3D (Walkaround)
          </h2>
        </div>
        <span class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1 rounded-lg border border-slate-800">
          {maquina.data.hotspots.length} Puntos Mapeados
        </span>
      </div>

      <!-- React 3D Island -->
      <Visor3D
        client:only="react"
        machineType={machine3dType}
        machineTitle={maquina.data.title}
        hotspots={maquina.data.hotspots}
      />
    </section>

    <!-- SECTION 2: Technical Specifications & EPP -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8">
      {/* Specs Panel */}
      <div class="md:col-span-6 bg-slate-900/90 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span>⚙️</span> Ficha Técnica de Rendimiento
        </h3>

        <div class="grid grid-cols-2 gap-4">
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-[11px] font-mono text-slate-400 block">POTENCIA BRUTA</span>
            <span class="text-lg font-bold text-amber-400 font-mono">{maquina.data.specs.potenciaHp} HP</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
            <span class="text-[11px] font-mono text-slate-400 block">PESO DE OPERACIÓN</span>
            <span class="text-lg font-bold text-white font-mono">{maquina.data.specs.pesoOperativoTn} Toneladas</span>
          </div>

          {maquina.data.specs.capacidadBaldeM3 && (
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
              <span class="text-[11px] font-mono text-slate-400 block">CAPACIDAD DE CUCHARÓN</span>
              <span class="text-lg font-bold text-white font-mono">{maquina.data.specs.capacidadBaldeM3} m³</span>
            </div>
          )}

          {maquina.data.specs.profundidadExcavacionM && (
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
              <span class="text-[11px] font-mono text-slate-400 block">PROFUNDIDAD MÁX. EXCAVACIÓN</span>
              <span class="text-lg font-bold text-white font-mono">{maquina.data.specs.profundidadExcavacionM} m</span>
            </div>
          )}

          {maquina.data.specs.presionHidraulicaPsi && (
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
              <span class="text-[11px] font-mono text-slate-400 block">ALIVIO HIDRÁULICO PRINCIPAL</span>
              <span class="text-lg font-bold text-cyan-400 font-mono">{maquina.data.specs.presionHidraulicaPsi} PSI</span>
            </div>
          )}

          {maquina.data.specs.velocidadMaxKmH && (
            <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800">
              <span class="text-[11px] font-mono text-slate-400 block">VELOCIDAD MÁXIMA</span>
              <span class="text-lg font-bold text-white font-mono">{maquina.data.specs.velocidadMaxKmH} km/h</span>
            </div>
          )}
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800 text-xs text-slate-400 leading-relaxed">
          * Valores basados en especificaciones estándar de fábrica Caterpillar / Komatsu bajo condiciones SAE J1349.
        </div>
      </div>

      {/* EPP Panel */}
      <div class="md:col-span-6 bg-slate-900/90 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span>🛡️</span> Equipos de Protección Requeridos (EPP)
        </h3>

        <div class="space-y-2.5">
          {maquina.data.eppRequerido.map((epp, idx) => (
            <div class="p-3 rounded-xl bg-slate-950/70 border border-slate-800/80 flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 font-bold text-xs flex items-center justify-center flex-shrink-0">
                {idx + 1}
              </span>
              <span class="text-xs text-slate-300 font-medium">{epp}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 3: Theory & Operational Guidelines (Markdown Content) -->
    <section class="bg-slate-900/60 border border-slate-800 rounded-3xl p-8 prose prose-invert max-w-none prose-headings:text-white prose-amber">
      <Content />
    </section>

    <!-- SECTION 4: Interactive Daily Checklist (Walkaround Protocol) -->
    <section id="checklist">
      <div class="mb-4">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-500">
          Inspección Diaria
        </div>
        <h2 class="text-2xl font-black text-white">
          Lista de Comprobación Operacional
        </h2>
      </div>

      <ChecklistMantenimiento
        client:load
        machineId={maquina.id}
        machineTitle={maquina.data.title}
        checklist={maquina.data.checklist}
      />
    </section>

    <!-- SECTION 5: Knowledge Validation Quiz -->
    <section id="quiz">
      <div class="mb-4">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-500">
          Certificación Teórica
        </div>
        <h2 class="text-2xl font-black text-white">
          Evaluación de Conocimiento del Equipo
        </h2>
      </div>

      <Quiz
        client:load
        machineTitle={maquina.data.title}
        questions={maquina.data.quiz}
      />
    </section>
  </div>
</BaseLayout>
