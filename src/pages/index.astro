---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const maquinas = await getCollection('maquinas');
const seguridad = await getCollection('seguridad');
---

<BaseLayout
  title="Machinery Academy | Plataforma Educativa para Operadores de Maquinaria Pesada"
  description="Domina la inspección pre-operacional en 3D, normas de seguridad minera y simuladores de operación para excavadoras, cargadores y retroexcavadoras."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 bg-industrial-grid border-b border-slate-800">
    <div class="absolute inset-0 bg-gradient-to-b from-amber-500/5 via-transparent to-[#0a0e17] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Top pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Estándar de Entrenamiento 2026
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
          Formación Técnica e Inspección 3D para <span class="text-amber-400 underline decoration-amber-500/40 decoration-4">Operadores Pesados</span>
        </h1>

        <p class="text-lg text-slate-300 mb-10 leading-relaxed max-w-2xl mx-auto font-normal">
          Aprende a inspeccionar cada punto crítico antes del encendido, domina los protocolos LOTO de seguridad y practica la secuencia de mandos en cabina con nuestro simulador interactivo.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/maquinas"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm uppercase tracking-wider transition-all shadow-xl shadow-amber-500/20 hover:scale-105"
          >
            Explorar Máquinas Piloto
          </a>
          <a
            href="/simulador"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm uppercase tracking-wider border border-slate-700 transition-all flex items-center justify-center gap-2"
          >
            🕹️ Simulador de Cabina
          </a>
        </div>
      </div>

      <!-- Quick Industrial Metric Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 max-w-4xl mx-auto">
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-400">3</div>
          <div class="text-xs text-slate-400 mt-1 uppercase font-semibold">Equipos Clave</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="text-3xl font-black text-white">360°</div>
          <div class="text-xs text-slate-400 mt-1 uppercase font-semibold">Visor Técnico WebGL</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-400">100%</div>
          <div class="text-xs text-slate-400 mt-1 uppercase font-semibold">Checklists Guardables</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 text-center">
          <div class="text-3xl font-black text-emerald-400">LOTO</div>
          <div class="text-xs text-slate-400 mt-1 uppercase font-semibold">Protocolos Mineros</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Machines Showcase Section -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-amber-500 mb-2">
          Catálogo Especializado
        </div>
        <h2 class="text-3xl font-black text-white">
          Maquinaria Pesada en Formación
        </h2>
      </div>
      <a
        href="/maquinas"
        class="text-sm font-semibold text-amber-400 hover:text-amber-300 mt-2 md:mt-0 flex items-center gap-1"
      >
        Ver catálogo completo →
      </a>
    </div>

    <!-- Machine Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {maquinas.map((m) => (
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl overflow-hidden hover:border-amber-500/50 transition-all group flex flex-col justify-between shadow-xl">
          <!-- Card Header / Image preview -->
          <div class="p-6 pb-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20">
                {m.data.category}
              </span>
              <span class="text-xs text-slate-400">
                {m.data.difficulty} • {m.data.durationHours}h
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors">
              {m.data.title}
            </h3>
            <div class="text-xs font-mono text-slate-500 mb-3">
              {m.data.model}
            </div>

            <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed mb-6">
              {m.data.description}
            </p>

            <!-- Technical specs pill row -->
            <div class="grid grid-cols-2 gap-2 text-xs bg-slate-950 p-3 rounded-xl border border-slate-800/80 mb-6 font-mono">
              <div>
                <span class="text-slate-500 block text-[10px]">POTENCIA</span>
                <span class="text-white font-bold">{m.data.specs.potenciaHp} HP</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">PESO OPERATIVO</span>
                <span class="text-white font-bold">{m.data.specs.pesoOperativoTn} Tn</span>
              </div>
            </div>

            <!-- Features pills -->
            <div class="flex items-center gap-2 text-[11px] text-slate-400">
              <span class="flex items-center gap-1 bg-slate-800/80 px-2 py-1 rounded-md">
                🔍 {m.data.hotspots.length} Puntos 3D
              </span>
              <span class="flex items-center gap-1 bg-slate-800/80 px-2 py-1 rounded-md">
                📋 Checklist
              </span>
              <span class="flex items-center gap-1 bg-slate-800/80 px-2 py-1 rounded-md">
                🏆 Quiz
              </span>
            </div>
          </div>

          <!-- Bottom Card Action -->
          <div class="p-6 pt-0 mt-auto">
            <a
              href={`/maquinas/${m.id}`}
              class="w-full py-3 px-4 rounded-xl bg-slate-800 group-hover:bg-amber-500 group-hover:text-slate-950 text-white font-bold text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2"
            >
              Entrar al Módulo de Inspección →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Safety Callout Banner -->
  <section class="py-16 bg-slate-950 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-amber-500/10 via-slate-900 to-slate-900 p-8 sm:p-12 rounded-3xl border border-amber-500/30 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">
            <span>⚠️</span> Seguridad Ocupacional Crítica
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-white mb-4">
            Normativa LOTO y Gestión de Puntos Ciegos
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            La operación segura comienza en el piso. Conoce los 5 pasos obligatorios de despresurización hidráulica, uso de candados personales y cómo prevenir atropellos en giros de 360°.
          </p>
          <a
            href="/seguridad"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all"
          >
            Ver Módulos de Seguridad
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full lg:w-auto">
          {seguridad.map((s) => (
            <div class="bg-slate-900/90 p-4 rounded-2xl border border-slate-800">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">
                {s.data.code}
              </span>
              <h4 class="text-sm font-bold text-white mt-2 mb-1">{s.data.title}</h4>
              <p class="text-xs text-slate-400 line-clamp-2">{s.data.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
