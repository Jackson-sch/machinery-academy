---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const articulosSeguridad = await getCollection('seguridad');
// Sort by order
articulosSeguridad.sort((a, b) => a.data.order - b.data.order);

// Render all content
const articulosConContenido = await Promise.all(
  articulosSeguridad.map(async (art) => {
    const { Content } = await render(art);
    return { ...art, Content };
  })
);
---

<BaseLayout
  title="Seguridad Minera, EPP y Procedimiento LOTO | Machinery Academy"
  description="Normas de seguridad laboral, bloqueo y etiquetado (LOTO), gestión de puntos ciegos y radiación de giro en obras pesadas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-400 text-xs font-bold uppercase tracking-wider mb-3 border border-red-500/20">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        Seguridad de Vida o Muerte
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Manual Transversal de Seguridad y LOTO
      </h1>
      <p class="text-base text-slate-400 mt-3 max-w-3xl">
        Protocolos obligatorios antes de abordar cualquier máquina pesada. Diseñado para garantizar Cero Incidentes en canteras, minería a tajo abierto y obras civiles.
      </p>
    </div>

    <!-- Security Modules Accordion / Cards List -->
    <div class="space-y-12">
      {articulosConContenido.map((art) => (
        <article class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-800 mb-8">
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-lg text-xs font-mono font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                {art.data.code}
              </span>
              <span class="text-xs uppercase font-mono text-slate-400">
                {art.data.category}
              </span>
            </div>

            <span
              class={`px-3 py-1 rounded-full text-xs font-bold uppercase ${
                art.data.priority === 'Crítica'
                  ? 'bg-red-500/20 text-red-400 border border-red-500/30'
                  : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
              }`}
            >
              Prioridad: {art.data.priority}
            </span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
            {art.data.title}
          </h2>

          <p class="text-sm text-slate-300 mb-8 leading-relaxed">
            {art.data.description}
          </p>

          <div class="bg-slate-950/70 p-6 sm:p-8 rounded-2xl border border-slate-800/80 prose prose-invert max-w-none prose-headings:text-white prose-amber">
            <art.Content />
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
